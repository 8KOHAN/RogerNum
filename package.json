{
  "name": "RogerNum",
  "version": "1.0.1",
  "private": true,
  "description": "Open-source random number generator browser extension with 12 languages and 12 themes.",
  "type": "module",
  "scripts": {
    "dev": "wxt -b firefox",
    "dev:firefox": "wxt -b firefox",
    "dev:chrome": "wxt -b chrome",
    "build": "wxt build -b firefox",
    "build:firefox": "wxt build -b firefox",
    "build:chrome": "wxt build -b chrome",
    "zip": "wxt zip -b firefox",
    "zip:firefox": "wxt zip -b firefox",
    "zip:chrome": "wxt zip -b chrome",
    "compile": "tsc --noEmit",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@wxt-dev/module-react": "^1.1.5",
    "typescript": "^5.9.3",
    "web-ext": "^10.8.0",
    "wxt": "^0.21.3"
  },
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/8KOHAN/RogerNum.git"
  },
  "homepage": "https://github.com/8KOHAN/RogerNum#readme",
  "bugs": {
    "url": "https://github.com/8KOHAN/RogerNum/issues"
  },
  "keywords": [
    "browser-extension",
    "random-number-generator",
    "wxt",
    "firefox",
    "chrome",
    "localization"
  ]
}
